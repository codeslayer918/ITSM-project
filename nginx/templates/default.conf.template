# Rendered by the official nginx entrypoint (envsubst, only variables matching
# NGINX_ENVSUBST_FILTER=PROXY_ are replaced; nginx variables stay untouched).

upstream backend {
    server backend:8080;
    keepalive 16;
}

# Coarse per-IP limit in front of the public enrolment / recovery endpoints.
# The backend applies finer limits (per IP and per account).
limit_req_zone $binary_remote_addr zone=public_api:10m rate=30r/m;
limit_req_status 429;

# Shared TLS settings: TLS 1.3 only, server certificate from the "Servers" CA.
ssl_protocols TLSv1.3;
ssl_certificate     /etc/nginx/pki/server-fullchain.crt;
ssl_certificate_key /etc/nginx/pki/server.key;
ssl_ecdh_curve X25519:prime256v1:secp384r1;
# No TLS session resumption: every connection runs a full handshake, so the client
# certificate is checked against the *current* CRL each time (a resumed session would
# skip certificate verification).
ssl_session_tickets off;
ssl_session_cache off;

server_tokens off;
client_max_body_size 64k;

# -----------------------------------------------------------------------------
# 8443 - application, mutual TLS required
# -----------------------------------------------------------------------------
server {
    listen 8443 ssl;
    http2 on;
    server_name localhost;

    # Only the Users CA chain is trusted for client certificates.
    ssl_client_certificate /etc/nginx/pki/client-trust.pem;
    ssl_verify_client on;
    ssl_verify_depth 2;
    # Root CRL + Users CA CRL, regenerated by the backend; crl-watch.sh reloads nginx.
    ssl_crl /etc/nginx/crl/crl-bundle.pem;

    # 495 = certificate verification failed, 496 = no certificate sent.
    error_page 495 = @cert_rejected;
    error_page 496 = @cert_missing;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    # Headers forwarded to the backend. proxy_set_header replaces any header of the same
    # name sent by the client, so these values cannot be spoofed from outside.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Proxy-Secret "${PROXY_SHARED_SECRET}";
    proxy_set_header X-Auth-Listener mtls;
    proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
    proxy_set_header X-SSL-Client-Cert $ssl_client_escaped_cert;
    proxy_set_header X-SSL-Client-S-DN $ssl_client_s_dn;
    proxy_set_header X-SSL-Client-Serial $ssl_client_serial;
    # SHA-1 fingerprint computed by nginx (informational); the backend computes SHA-256 itself.
    proxy_set_header X-SSL-Client-Fingerprint $ssl_client_fingerprint;

    location @cert_rejected {
        default_type application/json;
        return 403 '{"error":"client_certificate_rejected","reason":"$ssl_client_verify"}\n';
    }

    location @cert_missing {
        default_type application/json;
        return 403 '{"error":"client_certificate_required","reason":"no client certificate was sent"}\n';
    }

    location / {
        proxy_pass http://backend;
    }
}

# -----------------------------------------------------------------------------
# 9443 - public listener, no client certificate: enrolment, recovery, CRL only
# -----------------------------------------------------------------------------
server {
    listen 9443 ssl;
    http2 on;
    server_name localhost;

    ssl_verify_client off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Proxy-Secret "${PROXY_SHARED_SECRET}";
    proxy_set_header X-Auth-Listener public;
    # Empty value = header removed: a client cannot inject a fake certificate here.
    proxy_set_header X-SSL-Client-Verify "";
    proxy_set_header X-SSL-Client-Cert "";
    proxy_set_header X-SSL-Client-S-DN "";
    proxy_set_header X-SSL-Client-Serial "";
    proxy_set_header X-SSL-Client-Fingerprint "";

    location = / {
        return 302 /recover.html;
    }

    location /api/ {
        limit_req zone=public_api burst=20 nodelay;
        proxy_pass http://backend;
    }

    location ~ ^/(enroll\.html|recover\.html|assets/|crl/|ca/) {
        proxy_pass http://backend;
    }

    location / {
        return 404;
    }
}
